name: Flutter iOS CI/CD with TestFlight

on:
  push:
    branches:
      #- dev
      #- development-ci-cd

jobs:
  ios-build:
    runs-on: macos-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Install Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.38.3'
          channel: stable
          architecture: arm64

      - name: Flutter Pub Get
        run: flutter pub get

      - name: Flutter Analyze
        run: flutter analyze --no-fatal-infos --no-fatal-warnings

      - name: Run Flutter Tests
        run: flutter test

      - name: Install iOS dependencies (CocoaPods)
        run: |
          cd ios
          pod install

      - name: Install Fastlane
        run: sudo gem install fastlane -NV
        
      - name: 🔑 Import Code Signing Identity and Set Default Keychain
        uses: apple-actions/import-codesign-certs@v2 
        with:
          # Base64 string of your Apple Distribution .p12 file.
          p12-file-base64: ${{ secrets.P12_BASE64_CERT }} 
          # Password for the .p12 file (use MATCH_PASSWORD if the p12 came from match).
          p12-password: ${{ secrets.MATCH_PASSWORD }}

      - name: Build IPA + Upload to TestFlight
        # Set all necessary secrets as environment variables for Fastlane
        env:
          MATCH_PASSWORD: ${{ secrets.MATCH_PASSWORD }}
          ASC_API_KEY_ID: ${{ secrets.ASC_API_KEY_ID }}
          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
          ASC_API_KEY: ${{ secrets.ASC_API_KEY }}
        run: |
          cd ios
          # Execute the Fastlane lane
          fastlane beta

      - name: Upload IPA artifact
        uses: actions/upload-artifact@v4
        with:
          name: my-laundry-ios
          path: build/ios/Runner.ipa
